    "definitions": {
        "dto.Alert": {
            "type": "object",
            "properties": {
                "chance": {
                    "type": "number"
                },
                "date": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "shortfall": {
                    "type": "integer"
                }
            }
        },
        "dto.CreateUserRequest": {
            "type": "object",
            "required": [
                "company_name",
                "confirm_password",
                "email",
                "password"
            ],
            "properties": {
                "company_name": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 2
                },
                "confirm_password": {
                    "type": "string",
                    "minLength": 6
                },
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 6
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "dto.ForecastDay": {
            "type": "object",
            "properties": {
                "balance_high": {
                    "type": "integer"
                },
                "balance_low": {
                    "type": "integer"
                },
                "date": {
                    "type": "string"
                },
                "expected_balance": {
                    "type": "integer"
                },
                "inflow": {
                    "type": "integer"
                },
                "outflow": {
                    "type": "integer"
                }
            }
        },
        "dto.ForecastResponse": {
            "type": "object",
            "properties": {
                "alerts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.Alert"
                    }
                },
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ForecastDay"
                    }
                },
                "recurring_payments": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ScheduledPayment"
                    }
                },
                "rough": {
                    "type": "boolean"
                }
            }
        },
        "dto.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },

&НаКлиенте
Процедура ОтправитьВыписку(Команда)
    
    Сообщить("1С начала отправку выписки...");

    Если ПустаяСтрока(АдресБэкенда) Тогда
        Сообщить("ОШИБКА: Укажите Адрес бэкенда (ссылку из кабинета)");
        Возврат;
    КонецЕсли;
    
    Если ПустаяСтрока(ПутьКCSV) Тогда
        Сообщить("ОШИБКА: Укажите путь к CSV-файлу");
        Возврат;
    КонецЕсли;

    ТекстОтвета = "";
    Успех = ОтправитьНаСервере(АдресБэкенда, ИдентификаторПользователя, Токен1С, ПутьКCSV, ТекстОтвета);
    
    Если Успех Тогда
        Сообщить("УСПЕХ! Ответ сервера: " + ТекстОтвета);
    Иначе
        Сообщить(ТекстОтвета);
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ОтправитьНаСервере(АдресБэкенда, ИдентификаторПользователя, Токен1С, ПутьКCSV, ТекстОтвета)
    
    Попытка
        // 1. Проверка файла
        ФайлCSV = Новый Файл(ПутьКCSV);
        Если Не ФайлCSV.Существует() Тогда
            ТекстОтвета = "ОШИБКА: Файл не найден по пути " + ПутьКCSV;
            Возврат Ложь;
        КонецЕсли;

        Сообщить("Файл найден, готовим данные...");
        ИмяФайла = ФайлCSV.Имя;

        // 2. Разбор адреса
        Хост = "localhost";
        Порт = 80;
        БазаПути = "";
        
        Адрес = СокрЛП(АдресБэкенда);
        Протокол = "http://";
        Если Найти(НРег(Адрес), "https://") = 1 Тогда
            Протокол = "https://";
        КонецЕсли;
        БезПротокола = Сред(Адрес, СтрДлина(Протокол) + 1);
        
        Слэш = Найти(БезПротокола, "/");
        Если Слэш > 0 Тогда
            ХостПорт = Лев(БезПротокола, Слэш - 1);
            БазаПути = Сред(БезПротокола, Слэш);
        Иначе
            ХостПорт = БезПротокола;
        КонецЕсли;
        
        Двоеточие = Найти(ХостПорт, ":");
        Если Двоеточие > 0 Тогда
            Хост = Лев(ХостПорт, Двоеточие - 1);
            Порт = Число(Сред(ХостПорт, Двоеточие + 1));
        Иначе
            Хост = ХостПорт;
        КонецЕсли;

        // Gateway accepts raw CSV bodies as well as multipart. Send the file
        // bytes directly to avoid multipart body issues in different 1C builds.
        Тело = Новый ДвоичныеДанные(ПутьКCSV);
        Сообщить("Размер CSV: " + Строка(Тело.Размер()) + " байт");

        // 4. Отправка
        Сообщить("Данные собраны. Отправляю на " + Хост + ":" + Порт + "...");
        Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30);

        // Персональная ссылка из API-кабинета содержит user_id и token.
        // Переносим их также в заголовки: это совместимо со старым API и
        // не зависит от обработки query-параметров в версии 1С.
        ТокенДляЗапроса = Токен1С;
        IDДляЗапроса = ИдентификаторПользователя;
        Если ПустаяСтрока(ТокенДляЗапроса) Тогда
            ТокенДляЗапроса = ПолучитьПараметрАдреса(АдресБэкенда, "token");
        КонецЕсли;
        Если IDДляЗапроса = 0 Тогда
            IDДляЗапроса = Число(ПолучитьПараметрАдреса(АдресБэкенда, "user_id"));
        КонецЕсли;
        Если IDДляЗапроса = 0 Тогда
            ТекстОтвета = "ОШИБКА: в ссылке нет user_id, а идентификатор пользователя равен 0";
            Возврат Ложь;
        КонецЕсли;
        
        // Ваша логика: если ссылка уже содержит путь, используем её
        Если Найти(НРег(АдресБэкенда), "/integration/1c/statements") > 0 Тогда
            ПутьЗапроса = ПолучитьПутьСЗапросом(АдресБэкенда);
        Иначе
            ПутьЗапроса = БазаПути + "/integration/1c/statements";
        КонецЕсли;

        Запрос = Новый HTTPЗапрос(ПутьЗапроса);
        
        // Если токен пустой, но он есть в ссылке (query string), заголовок можно не ставить
        Если Не ПустаяСтрока(ТокенДляЗапроса) Тогда
            Запрос.Заголовки.Вставить("X-1C-Token", ТокенДляЗапроса);
        КонецЕсли;
        Запрос.Заголовки.Вставить("X-User-ID", Строка(IDДляЗапроса));
        Запрос.Заголовки.Вставить("Content-Type", "text/csv");
        Запрос.УстановитьТелоИзДвоичныхДанных(Тело);

        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        
        Если Ответ.КодСостояния = 200 Тогда
            ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
            Возврат Истина;
        Иначе
            ТекстОтвета = "Ошибка бэкенда " + Ответ.КодСостояния + ": " + Ответ.ПолучитьТелоКакСтроку();
            Возврат Ложь;
        КонецЕсли;

    Исключение
        ТекстОтвета = "Критическая ошибка: " + ОписаниеОшибки();
        Возврат Ложь;
    КонецПопытки;
    
КонецФункции

&НаСервере
Функция ПолучитьПараметрАдреса(Адрес, ИмяПараметра)
    Маркер = ИмяПараметра + "=";
    Позиция = Найти(НРег(Адрес), НРег(Маркер));
    Если Позиция = 0 Тогда Возврат ""; КонецЕсли;
    Значение = Сред(Адрес, Позиция + СтрДлина(Маркер));
    Амперсанд = Найти(Значение, "&");
    Если Амперсанд > 0 Тогда Значение = Лев(Значение, Амперсанд - 1); КонецЕсли;
    Возврат Значение;
КонецФункции

// Вспомогательные функции
&НаСервере
Функция ПолучитьДвоичныеИзСтроки(Текст)
    Поток = Новый ПотокВПамяти;
    Запись = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8, , Ложь);
    Запись.Записать(Текст);
    Запись.Закрыть();
    Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

&НаСервере
Функция ОбъединитьДвоичныеДанные(Левые, Правые)
    Поток = Новый ПотокВПамяти;
    Поток.Записать(Левые);
    Поток.Записать(Правые);
    Поток.Позиция = 0;
    Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

&НаСервере
Функция ПолучитьПутьСЗапросом(Адрес)
    Протокол = "http://";
    Если Найти(НРег(Адрес), "https://") = 1 Тогда Протокол = "https://"; КонецЕсли;
    БезПротокола = Сред(Адрес, СтрДлина(Протокол) + 1);
    Слэш = Найти(БезПротокола, "/");
    Если Слэш = 0 Тогда Возврат "/"; КонецЕсли;
    Возврат Сред(БезПротокола, Слэш);
КонецФункции

&НаКлиенте
Процедура ОтправитьВыписку(Команда)
    
    // 1. ПРОВЕРКА, ЧТО КОД ВООБЩЕ ЗАПУСТИЛСЯ
    Сообщить("1С начала отправку выписки...");

    Если ПустаяСтрока(АдресБэкенда) Тогда
        АдресБэкенда = "http://localhost:8080";
    КонецЕсли;
    
    Если ИдентификаторПользователя = 0 Тогда
        ИдентификаторПользователя = 4;
    КонецЕсли;
    
    Если ПустаяСтрока(ПутьКCSV) Тогда
        ПутьКCSV = "C:\Users\Виктор\Downloads\Telegram Desktop\C150_train.csv";
    КонецЕсли;
    
    Если ПустаяСтрока(Токен1С) И Найти(НРег(АдресБэкенда), "token=") = 0 Тогда
        Сообщить("ОШИБКА: Токен не введен!");
        Возврат;
    КонецЕсли;

    Если ПустаяСтрока(ПутьКCSV) Тогда
        Сообщить("ОШИБКА: Укажите путь к CSV-файлу");
        Возврат;
    КонецЕсли;

    Хост = "";
    Порт = 80;
    БазаПути = "";
    РазобратьАдрес(АдресБэкенда, Хост, Порт, БазаПути);

       // 2. ПРОВЕРКА ФАЙЛА
    ПроверяемыйФайл = Новый Файл(ПутьКCSV);
    Если Не ПроверяемыйФайл.Существует() Тогда
        Сообщить("ОШИБКА: Файл не найден по пути " + ПутьКCSV);
        Возврат;
	КонецЕсли;
	
    Сообщить("Файл найден, готовим данные...");
    
    ФайлCSV = Новый Файл(ПутьКCSV);
    ИмяФайла = ФайлCSV.Имя;
    ДанныеФайла = Новый ДвоичныеДанные(ПутьКCSV);

    Ид = Строка(Новый УникальныйИдентификатор);
    Ид = СтрЗаменить(Ид, "{", "");
    Ид = СтрЗаменить(Ид, "}", "");
    Граница = "----1CBoundary" + Ид;

    Перенос = Символы.ВК + Символы.ПС;

    Заголовок = "--" + Граница + Перенос
        + "Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """" + Перенос
        + "Content-Type: text/csv" + Перенос + Перенос;

    Хвост = Перенос + "--" + Граница + "--" + Перенос;

    Часть1_Данные = ПолучитьТекстовуюЧасть(Заголовок);
    Часть2_Данные = ПолучитьТекстовуюЧасть(Хвост);
    
    Двоичные1 = Новый ДвоичныеДанные(Часть1_Данные);
    Двоичные2 = Новый ДвоичныеДанные(Часть2_Данные);

    Тело = ОбъединитьДвоичныеДанные(Двоичные1, ДанныеФайла);
    Тело = ОбъединитьДвоичныеДанные(Тело, Двоичные2);

    // 3. ПРОВЕРКА ОТПРАВКИ
    Сообщить("Данные собраны. Отправляю на " + Хост + ":" + Порт + БазаПути + "...");

    Соединение = Новый HTTPСоединение(Хост, Порт, , , , 30);

    // API-кабинет выдаёт готовую ссылку с token и user_id в query string.
    // Если она вставлена целиком, не добавляем путь повторно.
    Если Найти(НРег(АдресБэкенда), "/integration/1c/statements") > 0 Тогда
        ПутьЗапроса = ПолучитьПутьСЗапросом(АдресБэкенда);
    Иначе
        ПутьЗапроса = БазаПути + "/integration/1c/statements";
    КонецЕсли;
    Запрос = Новый HTTPЗапрос(ПутьЗапроса);
    Запрос.Заголовки.Вставить("X-1C-Token", Токен1С);
    Запрос.Заголовки.Вставить("X-User-ID", Строка(ИдентификаторПользователя));
    Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
    Запрос.УстановитьТелоИзДвоичныхДанных(Тело);

    Попытка
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния = 200 Тогда
            Сообщить("УСПЕХ! Ответ сервера: " + Ответ.ПолучитьТелоКакСтроку());
        Иначе
            Сообщить("ОШИБКА БЭКЕНДА (" + Ответ.КодСостояния + "): " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;
    Исключение
        Сообщить("КРИТИЧЕСКАЯ ОШИБКА СЕТИ: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПутьСЗапросом(Адрес)
    Протокол = "http://";
    Если Найти(НРег(Адрес), "https://") = 1 Тогда Протокол = "https://"; КонецЕсли;
    БезПротокола = Сред(Адрес, СтрДлина(Протокол) + 1);
    Слэш = Найти(БезПротокола, "/");
    Если Слэш = 0 Тогда Возврат "/"; КонецЕсли;
    Возврат Сред(БезПротокола, Слэш);
КонецФункции

// --- Вспомогательные функции (оставляем как были) ---

&НаКлиенте
Функция ПолучитьТекстовуюЧасть(Текст)
    Поток = Новый ПотокВПамяти;
    Запись = Новый ЗаписьТекста(Поток, КодировкаТекста.UTF8, , Ложь);
    Запись.Записать(Текст);
    Запись.Закрыть();
    Поток.Позиция = 0;
    Рез = Поток.ЗакрытьИПолучитьДвоичныеДанные();
    Возврат Рез;
КонецФункции

&НаКлиенте
Функция ОбъединитьДвоичныеДанные(Левые, Правые)
    Поток = Новый ПотокВПамяти;
    Поток.Записать(Левые);
    Поток.Записать(Правые);
    Поток.Позиция = 0;
    Рез = Поток.ЗакрытьИПолучитьДвоичныеДанные();
    Возврат Рез;
КонецФункции

&НаКлиенте
Процедура РазобратьАдрес(Адрес, Хост, Порт, БазаПути)
    Адрес = СокрЛП(Адрес);
    Протокол = "http://";
    Если Найти(НРег(Адрес), "https://") = 1 Тогда
        Протокол = "https://";
    КонецЕсли;
    БезПротокола = Сред(Адрес, СтрДлина(Протокол) + 1);
    
    Слэш = Найти(БезПротокола, "/");
    Если Слэш > 0 Тогда
        ХостПорт = Лев(БезПротокола, Слэш - 1);
        БазаПути = Сред(БезПротокола, Слэш);
    Иначе
        ХостПорт = БезПротокола;
        БазаПути = "";
    КонецЕсли;
    
    Двоеточие = Найти(ХостПорт, ":");
    Если Двоеточие > 0 Тогда
        Хост = Лев(ХостПорт, Двоеточие - 1);
        ПортСтр = Сред(ХостПорт, Двоеточие + 1);
        Если ПустаяСтрока(ПортСтр) Тогда
            Порт = ?(Протокол = "https://", 443, 80);
        Иначе
            Порт = Число(ПортСтр);
        КонецЕсли;
    Иначе
        Хост = ХостПорт;
        Порт = ?(Протокол = "https://", 443, 80);
    КонецЕсли;
    
    Если ПустаяСтрока(Хост) Тогда
        Хост = "localhost";
    КонецЕсли;
КонецПроцедуры
